<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="114dp">

        <!-- name -->
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/details_name"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#3b9bff"
                android:layout_marginBottom="30dp"/>

        <!-- type -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">
            <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Type"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:textSize="15sp"/>

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/details_type"
                    android:textSize="15sp"/>
        </LinearLayout>

        <!-- time -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">
            <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Time"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:textSize="15sp"/>
            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/details_time_start"
                    android:textSize="15sp"
                    android:paddingRight="6dp"/>
            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" - "
                    android:textSize="15sp"/>
            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/details_time_end"
                    android:textSize="15sp"
                    android:paddingRight="6dp"/>
        </LinearLayout>

        <!-- days -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">
            <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Days"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:textSize="15sp"/>

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/details_days"
                    android:textSize="15sp"/>
        </LinearLayout>

        <!-- notifs -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">
            <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Notifications"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:textSize="15sp"/>

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/details_notif"
                    android:textSize="15sp"/>
        </LinearLayout>

        <!-- suggestions -->
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/details_sugg"
                android:textSize="15sp"
                android:textColor="#3b9bff"
                android:textStyle="bold"
                android:layout_marginBottom="18dp"/>

        <!-- buttons -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

            <Button
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:id="@+id/details_edit"
                    android:text="Edit"
                    android:layout_marginEnd="10dp"
                    android:backgroundTint="#3b9bff" />

            <Button
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:id="@+id/details_delete"
                    android:text="Delete"
                    android:layout_marginStart="10dp"
                    android:backgroundTint="#3b9bff" />

        </LinearLayout>

        <!-- recycler for routine history -->
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="History"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="#3b9bff"/>

        <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp"
                android:paddingBottom="80dp"/>


    </LinearLayout>

</ScrollView>